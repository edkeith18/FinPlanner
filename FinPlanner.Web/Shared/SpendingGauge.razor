@implements IDisposable
@inject FinPlanner.Web.Services.SpendingSummary Summary

<section class="spending-gauge" aria-label="First-year spending outlook">
    <div class="gauge-copy">
        <p class="gauge-eyebrow">SPENDING OUTLOOK</p>
        <h2>Your budget, in perspective.</h2>
        <p class="gauge-description">See how your first-year budget compares with your calculated spending limits.</p>
        <dl class="gauge-limits">
            <div><dt><span class="swatch safe"></span>Perpetual Spend</dt><dd>@Money(Summary.PerpetualSpend)</dd></div>
            <div><dt><span class="swatch good"></span>Maximum Spend</dt><dd>@Money(Summary.MaximumSpend)</dd></div>
        </dl>
        <p class="gauge-note">@(Ready ? "Teal: within perpetual. Gold: above perpetual, within maximum. Terracotta: above maximum." : "Spending limits appear after your plans have been calculated.")</p>
    </div>
    <div class="gauge-visual">
        <svg viewBox="80 0 470 295" role="img" aria-label="@AccessibleDescription">
            <title>@AccessibleDescription</title>
            @if (Ready)
            {
                <path d="@Sector(0, PerpetualFraction)" class="gauge-sector safe" />
                <path d="@Sector(PerpetualFraction, MaximumFraction)" class="gauge-sector good" />
                <path d="@Sector(MaximumFraction, 1)" class="gauge-sector warning" />
                <path d="@Tick(PerpetualFraction)" class="limit-tick" />
                <path d="@Tick(MaximumFraction)" class="limit-tick" />
                <g transform="translate(@Point(PerpetualFraction, 190))" class="limit-label"><text y="-6">@Compact(Summary.PerpetualSpend!.Value)</text><text y="9" class="limit-caption">Perpetual</text></g>
                <g transform="translate(@Point(MaximumFraction, 190))" class="limit-label"><text y="-6">@Compact(Summary.MaximumSpend!.Value)</text><text y="9" class="limit-caption">Maximum</text></g>
                <path d="@Needle" class="gauge-needle" />
                <circle cx="300" cy="230" r="7" class="needle-hub" />
            }
            else
            {
                <path d="@Sector(0, 1)" class="gauge-sector pending" />
            }
            <text x="300" y="30" text-anchor="middle" class="budget-number">@Compact(Budget)</text>
            <text x="300" y="49" text-anchor="middle" class="budget-caption">FIRST-YEAR BUDGET</text>
            <text x="145" y="251" text-anchor="middle" class="endpoint">$0</text>
            <text x="455" y="251" text-anchor="middle" class="endpoint">@(Ready ? Compact(Scale) : " - ")</text>
            <text x="300" y="281" text-anchor="middle" class="gauge-ratio">@(Summary.PerpetualSpend is > 0m ? $"{Budget / Summary.PerpetualSpend.Value:P0} of perpetual" : " -  of perpetual")</text>
        </svg>
        @if (Ready && Budget > Scale)
        {
            <p class="over-scale">Budget exceeds the displayed scale.</p>
        }
    </div>
</section>

@code {
    [Parameter] public decimal Budget { get; set; }

    private bool Ready => Summary.MaximumSpend is > 0m && Summary.PerpetualSpend is >= 0m
        && Summary.PerpetualSpend <= Summary.MaximumSpend;
    private decimal Scale => Summary.MaximumSpend.GetValueOrDefault() * 1.2m;
    private double PerpetualFraction => (double)(Summary.PerpetualSpend.GetValueOrDefault() / Scale);
    private double MaximumFraction => (double)(Summary.MaximumSpend.GetValueOrDefault() / Scale);
    private string AccessibleDescription => Ready
        ? $"First-year budget {Budget:C0}; perpetual spend {Summary.PerpetualSpend:C0}; maximum spend {Summary.MaximumSpend:C0}."
        : $"First-year budget {Budget:C0}. Spending limits have not been calculated or are unavailable.";

    private static string Money(decimal? amount) => amount?.ToString("C0") ?? " - ";
    private static string Compact(decimal amount)
        => $"${decimal.Round(amount / 1000m, 0, MidpointRounding.AwayFromZero):N0}K";
    private static string Point(double fraction, double radius)
    {
        var angle = Math.PI * (1 - fraction);
        return FormattableString.Invariant($"{300 + radius * Math.Cos(angle):F2},{230 - radius * Math.Sin(angle):F2}");
    }
    private static string Sector(double start, double end)
        => $"M 300,230 L {Point(start, 155)} A 155,155 0 0,1 {Point(end, 155)} Z";
    private static string Tick(double fraction) => $"M {Point(fraction, 147)} L {Point(fraction, 164)}";
    private string Needle => $"M 300,230 L {Point(Math.Clamp((double)(Budget / Scale), 0, 1), 168)}";

    protected override void OnInitialized() => Summary.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Summary.Changed -= Refresh;
}
