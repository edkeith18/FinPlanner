@page "/financial-plan"
@using FinPlanner.Engine
@inject Scenario scenario
@inject PlanCalculator Calculator
<PageTitle>Plan explorer | FinPlanner</PageTitle>
<div class="page-heading"><div><p class="eyebrow">YOUR FINANCIAL FUTURE</p><h1>Plan explorer</h1><p class="page-description">Explore your trajectory and find a spending level that works for you.</p></div><a class="btn btn-outline-primary" href="financial-scenario">Edit scenario</a></div>
<div class="plan-toolbar" aria-label="Plan type">
    <button class="@(mode == 0 ? "selected" : "")" @onclick="() => SelectMode(0)">Financial plan</button>
    <button class="@(mode == 1 ? "selected" : "")" @onclick="() => SelectMode(1)">Maximum spend</button>
    <button class="@(mode == 2 ? "selected" : "")" @onclick="() => SelectMode(2)">Perpetual spend</button>
</div>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (busy)
{
    <section class="empty-state" role="status" aria-live="polite"><h2>Calculating your plans...</h2><p>Preparing your financial, maximum spend, and perpetual spend forecasts.</p></section>
}
else if (plan is null)
{
    <section class="empty-state"><h2>Your next chapter, in numbers.</h2><p>Review your accounts and assumptions, then return here to explore your annual forecast.</p><a class="btn btn-outline-primary" href="financial-scenario">Review scenario</a></section>
}
else
{
    <div class="metric-grid">
        <section class="metric-card"><span>First-year expenses</span><strong>@plan.PlanYears.FirstOrDefault()?.TotalExpenses.ToString("C0")</strong><small>@plan.Name</small></section>
        <section class="metric-card"><span>Final account balance</span><strong>@plan.PlanYears.LastOrDefault()?.EndingBalance.ToString("C0")</strong><small>At end of calculated forecast</small></section>
        <section class="metric-card"><span>Planning horizon</span><strong>@plan.PlanYears.Count years</strong><small>Starting at age @scenario.CurrentAge</small></section>
    </div>
    @if (!plan.IsSuccessful) { <div class="alert alert-warning" role="status">@plan.FailureReason</div> }
    <div class="section-heading"><h2>Annual forecast</h2><label><input type="checkbox" @bind="showDetails" /> Expense breakdown</label></div>
    <div class="forecast-scroll" tabindex="0" role="region" aria-label="Annual financial forecast">
        <table class="table forecast-table"><thead><tr><th scope="col">Year / age</th><th scope="col">Total expenses</th><th scope="col">Taxes</th><th scope="col">Ending balance</th>
        @if (showDetails) { foreach (var name in expenseNames) { <th scope="col">@name</th> } }
        </tr></thead><tbody>
        @foreach (var row in plan.PlanYears)
        {
            <tr><th scope="row">@row.StartingYear <small>Age @row.StartingAge</small></th><td>@row.TotalExpenses.ToString("C0")</td><td>@row.TaxExpense.ToString("C0")</td><td class="balance-cell">@row.EndingBalance.ToString("C0")</td>
            @if (showDetails) { foreach (var name in expenseNames) { <td>@row.Expenses.Where(e => e.Name == name).Sum(e => e.Amount).ToString("C0")</td> } }
            </tr>
        }
        </tbody></table>
    </div>
}
@code {
    private readonly Plan?[] plans = new Plan?[3];
    private readonly string?[] errors = new string?[3];
    private Plan? plan => plans[mode];
    private string? error => errors[mode];
    private int mode;
    private bool busy = true;
    private bool showDetails;
    private List<string> expenseNames = [];

    private void SelectMode(int value)
    {
        mode = value;
        expenseNames = plan?.PlanYears.SelectMany(y => y.Expenses)
            .Where(e => e.Type != ExpenseType.Tax).Select(e => e.Name).Distinct().ToList() ?? [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Show the loading state before running the synchronous engine calculations.
        await Task.Yield();
        try
        {
            if (scenario.Accounts.Count == 0) throw new InvalidOperationException("Add at least one account in your scenario before calculating a plan.");
            if (scenario.LifeExpectancy <= scenario.CurrentAge) throw new InvalidOperationException("Life expectancy must be greater than your current age.");
            for (var index = 0; index < plans.Length; index++)
            {
                try
                {
                    plans[index] = index switch
                    {
                        1 => Calculator.CalculateMaximumSpend(scenario),
                        2 => Calculator.CalculatePerpetualSpend(scenario),
                        _ => Calculator.CalculateCurrentTrajectory(scenario)
                    };
                }
                catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or NotSupportedException or OverflowException)
                { errors[index] = ex.Message; }
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or NotSupportedException or OverflowException)
        { Array.Fill(errors, ex.Message); }
        finally
        {
            busy = false;
            SelectMode(mode);
            StateHasChanged();
        }
    }
}
