@page "/financial-plan"
@using FinPlanner.Engine
@inject Scenario scenario
@inject FinPlanner.Web.Services.SpendingSummary SpendingSummary
<PageTitle>Plan explorer | FinPlanner</PageTitle>
<div class="page-heading"><div><p class="eyebrow">YOUR FINANCIAL FUTURE</p><h1>Plan explorer</h1><p class="page-description">Explore your trajectory and find a spending level that works for you.</p></div><a class="btn btn-outline-primary" href="financial-scenario">Edit scenario</a></div>
<div class="plan-toolbar" aria-label="Plan type">
    <button class="@(mode == 0 ? "selected" : "")" @onclick="() => SelectMode(0)">Financial plan</button>
    <button class="@(mode == 1 ? "selected" : "")" @onclick="() => SelectMode(1)">Maximum spend</button>
    <button class="@(mode == 2 ? "selected" : "")" @onclick="() => SelectMode(2)">Perpetual spend</button>
</div>
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (plan is null)
{
    <section class="empty-state"><h2>Your next chapter, in numbers.</h2><p>Load a scenario to prepare your financial, maximum spend, and perpetual spend forecasts.</p><a class="btn btn-outline-primary" href="financial-scenario">Review scenario</a></section>
}
else
{
    <div class="metric-grid">
        <section class="metric-card"><span>First-year expenses</span><strong>@plan.PlanYears.FirstOrDefault()?.TotalExpenses.ToString("C0")</strong><small>@plan.Name</small></section>
        <section class="metric-card"><span>Final account balance</span><strong>@plan.PlanYears.LastOrDefault()?.EndingBalance.ToString("C0")</strong><small>At end of calculated forecast</small></section>
        <section class="metric-card"><span>Planning horizon</span><strong>@plan.PlanYears.Count years</strong><small>Starting at age @scenario.CurrentAge</small></section>
    </div>
    @if (!plan.IsSuccessful) { <div class="alert alert-warning" role="status">@plan.FailureReason</div> }
    <AnnualForecast Years="plan.PlanYears" />

}
@code {
    private Plan? plan => mode switch
    {
        1 => SpendingSummary.MaximumPlan,
        2 => SpendingSummary.PerpetualPlan,
        _ => SpendingSummary.FinancialPlan
    };
    private string? error => mode switch
    {
        1 => SpendingSummary.MaximumError,
        2 => SpendingSummary.PerpetualError,
        _ => SpendingSummary.FinancialError
    };
    private int mode;
    private void SelectMode(int value) => mode = value;
}
