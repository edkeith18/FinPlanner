@page "/account/new"
@page "/account/{name}"

@using FinPlanner.Engine
@using Microsoft.AspNetCore.Components

@inject Scenario scenario
@inject NavigationManager Nav

<h3>@(IsNew ? "Create Account" : "Account Details")</h3>

@if (account is null)
{
    <p>Account not found.</p>
}
else
{
    <div class="card p-3" style="max-width: 400px;">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText @bind-Value="account.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Balance</label>
            <InputNumber @bind-Value="account.BeginningBalance" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Type</label>
            <InputSelect @bind-Value="account.Type" class="form-select">
                @foreach (var typeOption in AccountOptionDisplay.Types)
                {
                    <option value="@typeOption">@typeOption.ToDisplayLabel()</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Holdings</label>
            <InputSelect @bind-Value="account.Holdings" class="form-select">
                @foreach (var holdingsOption in AccountOptionDisplay.Holdings)
                {
                    <option value="@holdingsOption">@holdingsOption.ToDisplayLabel()</option>
                }
            </InputSelect>
        </div>

        @if (account.Type == AccountType.Brokerage)
        {
            <div class="mb-3"><label class="form-label">Cost basis</label><InputNumber @bind-Value="account.Basis" class="form-control" min="0" /></div>
        }
        <button class="btn btn-primary" @onclick="Save">
            @(IsNew ? "Create" : "Save")
        </button>

        <button class="btn btn-secondary ms-2" @onclick="Back">
            Back
        </button>
    </div>
}

@code {
    [Parameter] public string? Name { get; set; }

    private Account? account;
    private bool IsNew => Name is null;

    protected override void OnParametersSet()
    {
        if (IsNew)
        {
            account = new Account { Name = "", BeginningBalance = 0, Type = AccountType.Brokerage, Holdings = AccountHoldings.Equities };
        }
        else
        {
            var source = scenario.Accounts.FirstOrDefault(a => a.Name == Name);
            account = source is null ? null : new Account(source) { BeginningBalance = source.BeginningBalance };
        }
    }

    private void Save()
    {
        if (account is null)
            return;

        if (IsNew)
        {
            scenario.AddAccount(account.Name, account.BeginningBalance, account.Type, account.Holdings);
        }

        else
        {
            var index = scenario.Accounts.FindIndex(a => a.Id == account.Id);
            if (index >= 0) scenario.Accounts[index] = account;
        }
        if (IsNew) scenario.Accounts[^1].Basis = account.Basis;
        scenario.NotifyStateChanged();
        Nav.NavigateTo("financial-scenario");
    }

    private void Back()
    {
        Nav.NavigateTo("financial-scenario");
    }
}
